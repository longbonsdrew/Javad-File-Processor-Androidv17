<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/paper">

    <LinearLayout android:layout_width="match_parent" android:layout_height="150dp"
        android:orientation="vertical" android:gravity="center_vertical"
        android:padding="10dp" android:background="@color/forest">
        <LinearLayout android:layout_width="match_parent" android:layout_height="74dp"
            android:orientation="horizontal" android:gravity="center_vertical|start">
        <ImageView android:layout_width="72dp" android:layout_height="72dp"
            android:scaleType="fitCenter" android:adjustViewBounds="true"
            android:src="@drawable/forsite_javad_ui_logo"
            android:contentDescription="FORSITE and JAVAD logo"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="62dp"
            android:orientation="horizontal" android:gravity="center_vertical">
        <View android:layout_width="7dp" android:layout_height="match_parent" android:background="@color/orange_red"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_vertical|end" android:paddingEnd="6dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FIELD OPERATIONS  |  GNSS" android:textColor="@color/mint" android:textSize="12sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Javad File Processor" android:textColor="@color/white" android:textStyle="bold" android:textSize="21sp"/>
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/controlScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TRIUMPH-2 STATIC POINT PROCESSING" android:textColor="@color/green" android:textStyle="bold" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Choose the observation and results folders, sign in to JAVAD, then start processing." android:textColor="@color/forest" android:textSize="14sp"/>

            <Button android:id="@+id/inputButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="14dp" android:text="1. Choose observation folder"/>
            <TextView android:id="@+id/inputPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No folder selected" android:textColor="@color/forest"/>
            <Button android:id="@+id/outputButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="8dp" android:text="2. Choose results folder"/>
            <TextView android:id="@+id/outputPath" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No folder selected" android:textColor="@color/forest"/>
            <Button android:id="@+id/loginButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="8dp" android:text="3. Sign in / open JAVAD"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="ArcGIS project" android:textStyle="bold" android:textColor="@color/forest"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Spinner android:id="@+id/projectSpinner" android:layout_width="0dp" android:layout_height="52dp"
                    android:layout_weight="1"/>
                <Button android:id="@+id/addProjectButton" android:layout_width="wrap_content" android:layout_height="52dp"
                    android:layout_marginStart="6dp" android:text="+ Project"/>
            </LinearLayout>
            <Button android:id="@+id/arcGisLoginButton" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="6dp" android:text="4. Sign in to ArcGIS"/>
            <TextView android:id="@+id/arcGisStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="ArcGIS: sign-in required" android:textColor="@color/forest"/>
            <Button android:id="@+id/refreshProjectsButton" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="4dp" android:text="Refresh NMI Mobile Map projects"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maximum wait per plot" android:textColor="@color/forest"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <Button android:id="@+id/waitMinus" android:layout_width="56dp" android:layout_height="52dp" android:text="−" android:contentDescription="Decrease wait by one minute"/>
                    <EditText android:id="@+id/maxWait" android:layout_width="72dp" android:layout_height="52dp" android:layout_marginStart="4dp" android:inputType="number" android:selectAllOnFocus="true" android:singleLine="true" android:text="10" android:maxLength="3" android:gravity="center" android:contentDescription="Maximum wait in minutes"/>
                    <Button android:id="@+id/waitPlus" android:layout_width="56dp" android:layout_height="52dp" android:layout_marginStart="4dp" android:text="+" android:contentDescription="Increase wait by one minute"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="minutes" android:textColor="@color/forest"/>
                </LinearLayout>
            </LinearLayout>
            <CheckBox android:id="@+id/reprocessCheck" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Process files again when TXT output already exists" android:textColor="@color/forest"/>
            <CheckBox android:id="@+id/recentSubmissionCheck" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Skip upload if same filename was submitted to JAVAD in last hour (check all projects)"
                android:textColor="@color/forest"/>

            <TextView android:id="@+id/uploadText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Uploading: 0% — 0 of 0" android:textStyle="bold" android:textColor="@color/forest"/>
            <com.forsite.javadprocessor.StripedProgressView android:id="@+id/uploadProgress"
                android:layout_width="match_parent" android:layout_height="22dp"/>
            <TextView android:id="@+id/downloadText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="Downloading: 0% — 0 of 0" android:textStyle="bold" android:textColor="@color/forest"/>
            <com.forsite.javadprocessor.StripedProgressView android:id="@+id/downloadProgress"
                android:layout_width="match_parent" android:layout_height="22dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="▶ Start Processing" android:textColor="@color/white" android:backgroundTint="@color/green"/>
                <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="■ Stop Safely" android:textColor="@color/white" android:backgroundTint="@color/orange_red" android:enabled="false"/>
            </LinearLayout>
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="Select folders to begin." android:textStyle="bold" android:textColor="@color/forest"/>
            <TextView android:id="@+id/failedText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/orange_red" android:textStyle="bold"/>
            <Button android:id="@+id/viewFullLogButton" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="View full process log"/>
            <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="180dp"
                android:layout_marginTop="8dp" android:background="@color/forest" android:textColor="@color/white"
                android:fontFamily="monospace" android:padding="10dp" android:gravity="top"
                android:scrollbars="vertical" android:fadeScrollbars="false" android:textIsSelectable="true" android:textSize="12sp"/>
        </LinearLayout>
    </ScrollView>

    <FrameLayout android:id="@+id/browserPanel" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <Button android:id="@+id/backToControls" android:layout_width="wrap_content" android:layout_height="48dp"
            android:layout_gravity="top|end" android:layout_margin="12dp" android:text="Return to Processor" android:backgroundTint="@color/orange_red" android:textColor="@color/white"/>
    </FrameLayout>
</LinearLayout>
